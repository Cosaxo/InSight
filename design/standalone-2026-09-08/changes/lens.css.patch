+
+/* ── polish & optimize (Sep 2026) ── */
+/* 44px hit areas on the small round controls — the drawn 32px stays, the pseudo carries the slack */
+.icon-btn,.avatar-btn,.pt-info{position:relative}
+.icon-btn::after,.avatar-btn::after,.mmt-card-x::after{content:"";position:absolute;inset:-6px;border-radius:50%}
+
+/* ── third pass (Sep 2026) ── */
+/* the remaining sub-44px controls get their slack the same way: the tab bar's three stops
+   (33px drawn) reach 44px; the Patterns pops (30px) and the mirror's zoom buttons (30px) too.
+   .pt-pops clips its children (overflow-x:auto), so it trades 7px of padding for the same
+   negative margin — same place on the page, room for the pseudo inside the clip box. */
+.tab-btn{position:relative}
+.tab-btn::after{content:"";position:absolute;left:0;right:0;top:50%;height:44px;transform:translateY(-50%);border-radius:999px}
+.pt-pops{padding:7px 0;margin:-7px 0}
+.pt-pop{position:relative}
+.pt-pop::after{content:"";position:absolute;left:0;right:0;top:50%;height:44px;transform:translateY(-50%);border-radius:999px}
+.mmt-zoomctl button{position:relative}
+.mmt-zoomctl button::after{content:"";position:absolute;inset:-7px;border-radius:50%}
+.pt-info::after{content:"";position:absolute;inset:-8px;border-radius:50%}
+/* one switch honours reduced motion for everything the app animates */
+@media (prefers-reduced-motion:reduce){#root *,#root *::before,#root *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
