--- recorded/lens.css
+++ 2026-09-06/lens.css
@@ -13,22 +13,22 @@
 .app.lens-paper .ln-field::before{background:radial-gradient(circle at 50% 46%,oklch(0.992 0.003 80),oklch(0.955 0.006 75) 80%);box-shadow:inset 0 0 0 1px var(--rule)}
 .ln-svg{position:absolute;inset:0;width:100%;height:100%;display:block;overflow:visible;touch-action:manipulation}
 .ln-svg text{font-family:var(--sans)}
-.ln-key{display:flex;flex-wrap:wrap;gap:5px 14px;padding:10px 8px 4px;font-size:11.5px;font-weight:600;color:var(--ink-3)}
+.ln-key{display:flex;flex-wrap:wrap;gap:5px 14px;padding:10px 8px 4px;font-size: 12px;font-weight:600;color:var(--ink-3)}
 .ln-key>span{display:inline-flex;align-items:center;gap:6px}
 .ln-key i{display:inline-block;flex:none;box-sizing:border-box}
 .ln-key .k-dot{width:8px;height:8px;border-radius:50%;background:var(--ink-3)}
 .ln-key .k-ring{width:8px;height:8px;border-radius:50%;border:1.3px solid var(--ink-3)}
 .ln-key .k-line{width:14px;height:0;border-top:1.5px solid var(--ink-3)}
 .ln-key .k-dash{width:14px;height:0;border-top:1.5px dashed var(--ink-3)}
-.ln-hint{padding:2px 8px 8px;font-size:11.5px;font-weight:700;color:var(--accent-ink)}
+.ln-hint{padding:2px 8px 8px;font-size: 12px;font-weight:700;color:var(--accent-ink)}
 .ln-rail{display:flex;align-items:center;gap:6px;padding:4px 2px 8px;overflow-x:auto;scrollbar-width:none}
 .ln-rail::-webkit-scrollbar{display:none}
-.ln-rail-lab{flex:none;font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);margin:0 4px 0 6px}
+.ln-rail-lab{flex:none;font-size: 12px;font-weight:800;letter-spacing: 0.07em;text-transform:uppercase;color:var(--ink-3);margin:0 4px 0 6px}
 .ln-chip{flex:none;display:flex;align-items:center;gap:7px;height:32px;padding:0 10px 0 4px;border-radius:999px;border:1px solid var(--rule);background:var(--surface);font:inherit;color:var(--ink);cursor:pointer;-webkit-appearance:none}
 .ln-chip.is-on{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
-.ln-chip .c-av{width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:800}
+.ln-chip .c-av{width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size: 12px;font-weight:800}
 .ln-chip .c-name{font-size:12.5px;font-weight:700}
-.ln-chip .c-sub{font-size:11px;font-weight:600;color:var(--ink-3);white-space:nowrap}
+.ln-chip .c-sub{font-size: 12px;font-weight:600;color:var(--ink-3);white-space:nowrap}
 @keyframes lnPulse{0%{r:6px;opacity:.85}100%{r:19px;opacity:0}}
 .ln-pulse{animation:lnPulse 1.9s ease-out infinite}
 @media (prefers-reduced-motion:reduce){.ln-pulse{animation:none;opacity:.5}}
