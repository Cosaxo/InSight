{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    /* "node" is for the test files that read fixtures off disk (node:fs,
       __dirname) — a dozen of them under src. It was here implicitly all
       along: vitest 3's own typings leaked @types/node ambients into any
       file importing vitest, and vitest 4 stopped, which is how the leak
       became visible. Browser code abusing a node global still fails
       where it always did — vite's build has no node builtins to give
       it. */
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* lens-content.test.ts imports content/lenses.json to bind the seeded
       bank's source to IS_LENSES (D91) — Vite and vitest resolve JSON
       natively, this line is what lets tsc -b agree. */
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* The three projects here and functions/tsconfig.json used to hold three
       DIFFERENT subsets of these: this one and tsconfig.node.json had no
       noImplicitReturns, functions/ had no noUnusedParameters and no
       noFallthroughCasesInSwitch. Nothing chose those subsets — they are what
       three configs written at three different times happen to contain, and
       each missing flag costs zero errors today (measured: tsc -b, the
       functions build and functions/tsconfig.test.json all stay at 0 with the
       full set). Aligned, so the strictness of a file no longer depends on
       which project happens to include it.
       Note what this still does NOT reach: the app project compiles .ts/.tsx
       only, so the spec layer's ~33k lines of JSX have no return-path check
       at all and eslint remains the only thing looking at them. */
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
