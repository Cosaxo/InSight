# ── Capacitor / native build artifacts ────────────────────────────
# The ios/ and android/ project shells are committed so anyone can
# build the apps; their generated build output, dependency caches,
# and IDE state are not.

# Vite output that Capacitor copies into native shells on `cap sync`
ios/App/App/public/
android/app/src/main/assets/public/
ios/App/App/capacitor.config.json
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# iOS build / Pods / IDE state
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/DerivedData/
ios/build/
ios/.gradle/
xcuserdata/
*.xcuserstate

# Android build / Gradle cache / IDE state
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml

# ── Signing material — NEVER commit ───────────────────────────────
# A leaked upload key lets someone publish as you, and a `git add -A`
# after a signing session is an incident no revert can undo (the
# object stays in history and the key must be rotated with Google).
# Keep the real keystore outside the repo entirely; these patterns are
# the backstop, not the plan. See docs/SHIP-CHECKLIST.md.
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
keystore.properties
signing.properties
google-services.json
GoogleService-Info.plist


# style-diff writes its full report here (scripts/style-diff.mjs)
style-diff.json

# The test-user harness's local roster (scripts/test-users.mjs). Holds the
# emulator credentials for each synthetic account, so it is both machine-local
# state and — even against a throwaway project — a password file.
.test-users.json

# vitest coverage reports (npm run test:coverage, and --prefix functions).
# Report-only and regenerated on demand — see vite.config.ts for why there
# are no thresholds and why spec/ is excluded.
coverage/
functions/coverage/

# Store screenshot captures (scripts/gen-screenshots.mjs). The PNGs are
# ~3.8 MB per run and get recaptured every release — and the demo-mode
# set is explicitly NOT uploadable (the harness names which scene and
# why), so keeping them in history mostly invites uploading the wrong
# ones. manifest.json IS tracked: it is the record of what was captured,
# in which mode, and what was flagged. The feature graphic is tracked
# too — that one is a finished asset, not a preview.
design/store/screenshots/*/*.png

# The pulse console's outputs. Only the TRAIL is committed
# (monitoring/pulse-trail.jsonl) — it is the one file here carrying
# information the tree does not already hold, namely what the numbers were on
# days nobody is looking at any more.
#
# pulse.json was committed at first and should not have been: it is derivable
# from the tree plus today's date, and `runwayDays` moves every midnight by
# construction, so committing it means a bot commit every single day forever
# for a file anyone can regenerate in a second. The trail already carries the
# figures worth diffing (burn, runway, alert coverage), so the "reviewable
# diff" argument it was committed for is served without the churn.
monitoring/pulse.json
monitoring/pulse.html

# Built question reports (scripts/build-report.mjs, D251). The roll CSV
# carries public app names — a deliverable for the buyer, never repo
# content.
reports/
