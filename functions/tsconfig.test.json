{
  // THE BACKEND'S TEST FILES, TYPECHECKED — which nothing did until
  // 2026-09-09.
  //
  // `tsconfig.json` beside this one ends `"exclude": ["src/**/*.test.ts"]`,
  // and that exclusion is right for the BUILD: the deployed bundle must not
  // carry 39 test files. But nothing else reached them either — the root
  // `tsconfig.json` references only `tsconfig.app.json` (include: src) and
  // `tsconfig.node.json` (vite/capacitor config, two scripts, and
  // firestore-tests), `functions/package.json`'s `build` is a bare `tsc`,
  // and `vitest run` does not typecheck. So 39 files, ~14k lines, were
  // compiled by nobody, and the first run of this config found 27 real
  // errors in six of them.
  //
  // `tsconfig.node.json`'s own header records this exact hole having shipped
  // once already, for `firestore-tests/rules.test.ts`. This is the same hole
  // one directory over.
  //
  // WHAT A DRIFTED FIXTURE COSTS. Nothing in production — these files never
  // ship. What it costs is the test's meaning: `paid.test.ts` priced the
  // money path against a `PricingCard` carrying a field the type retired and
  // missing three the type requires, so it was asserting about a shape the
  // server cannot receive. A suite that typechecks cannot drift away from
  // the code it is testing without saying so.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Checking only — the build config's `outDir`/`rootDir` are for emit,
    // and this must never write anything into `lib/`. `rootDir` is cleared
    // with them: it is `src`, and `vitest.config.ts` sits beside this file,
    // which TS6059 refuses while a rootDir is set.
    "noEmit": true,
    "rootDir": ".",
    // `esnext` + `bundler`, NOT the build's `node16` pair, and the reason is
    // vitest: it resolves these files itself and permits extensionless
    // relative imports (`from "./pure"`), which `node16` refuses. Matching
    // the runner is the point — this config exists to check the files as
    // vitest actually loads them.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  // The build's `exclude` is exactly what this config is for, so it is
  // cleared rather than inherited.
  "exclude": [],
  "include": ["src/**/*.test.ts", "vitest.config.ts"]
}
