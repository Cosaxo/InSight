{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Everything TypeScript outside src/. This list was `vite.config.ts` and
     `scripts/appcheck-guard.ts` alone, which left four files checked by
     nothing at all: vitest transpiles without typechecking, so
     firestore-tests/rules.test.ts ran green for as long as it has existed
     while carrying four real type errors (the compat-vs-modular Firestore
     the harness returns — see the cast at the top of that file).
     firestore-tests/README.md's "outside src/ so the app's tsc -b never
     compiles them" is about the APP project, and stays true: they are
     here, not in tsconfig.app.json. */
  "include": [
    "vite.config.ts",
    "capacitor.config.ts",
    "scripts/appcheck-guard.ts",
    "scripts/appcheck-guard.test.ts",
    "firestore-tests/**/*.ts"
  ]
}
