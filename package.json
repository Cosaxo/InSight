    "test:e2e:all": "STRIPE_WEBHOOK_SECRET=whsec_e2e firebase emulators:exec --only auth,firestore,functions,storage --project demo-insight \"node firestore-tests/e2e-v2-loop.mjs && node firestore-tests/e2e-delete-account.mjs && node firestore-tests/e2e-moderation.mjs\"",
