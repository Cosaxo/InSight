{
  "name": "insight",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "preview": "vite preview",
    "build:mobile": "npm run build && npx cap sync",
    "sync": "npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "doctor": "npx cap doctor",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --dir firestore-tests\"",
    "pretest:e2e": "npm run build --prefix functions",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-insight \"node firestore-tests/e2e-v2-loop.mjs\"",
    "pretest:e2e:erasure": "npm run build --prefix functions",
    "test:e2e:erasure": "firebase emulators:exec --only auth,firestore,functions --project demo-insight \"node firestore-tests/e2e-delete-account.mjs\"",
    "pretest:e2e:moderation": "npm run build --prefix functions",
    "test:e2e:moderation": "firebase emulators:exec --only auth,firestore,functions --project demo-insight \"node firestore-tests/e2e-moderation.mjs\"",
    "check:globals": "node scripts/check-spec-globals.mjs",
    "check:figures": "node scripts/check-figures.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:labels": "node scripts/check-labels.mjs",
    "check:purge": "node scripts/check-purge-listeners.mjs",
    "check:cities": "node scripts/check-cities.mjs",
    "check:pokedex": "node scripts/check-pokedex.mjs",
    "build:pokedex": "node scripts/build-pokedex.mjs",
    "check:catalogs": "node scripts/check-catalogs.mjs",
    "check:logic-sync": "node scripts/check-logic-sync.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build:content": "node scripts/gen-v2content.mjs --write",
    "promote": "node scripts/promote-questions.mjs",
    "scorecard": "node scripts/question-scorecard.mjs",
    "costs": "node scripts/cost-model.mjs",
    "pulse": "node scripts/pulse.mjs",
    "build:emoji": "node scripts/build-emoji.mjs",
    "check:ios-spm": "node scripts/check-ios-spm.mjs",
    "check:ios-facebook": "node scripts/check-ios-facebook.mjs",
    "postinstall": "node scripts/strip-facebook-sdk.mjs",
    "build:cities": "node scripts/build-cities.mjs",
    "check:deploy-targets": "node scripts/check-deploy-targets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:web-firebase": "node scripts/check-web-firebase.mjs",
    "check:fn-runtime": "node scripts/check-fn-runtime.mjs",
    "check:appcheck": "node scripts/check-appcheck.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:store-copy": "node scripts/check-store-copy.mjs",
    "check:store-listing": "node scripts/check-store-listing.mjs",
    "build:screenshots": "node scripts/gen-screenshots.mjs",
    "asc:push": "node scripts/asc-push.mjs",
    "monitoring:apply": "node scripts/apply-monitoring.mjs",
    "check:monitoring": "node scripts/check-monitoring.mjs",
    "build:feature-graphic": "node scripts/gen-feature-graphic.mjs",
    "test:unit": "vitest run --dir src",
    "test:scripts": "vitest run --dir scripts",
    "test:coverage": "vitest run --dir src/v2/data --coverage",
    "check:store-forms": "node scripts/check-store-forms.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.3.3",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@sentry/capacitor": "^4.2.0",
    "@sentry/react": "10.60.0",
    "capacitor-firebase-app-check": "npm:@capacitor-firebase/app-check@^8.3.0",
    "firebase": "^12.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/ios": "^8.3.3",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "appBuild": 1
}
