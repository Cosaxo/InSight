<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is off deliberately (decision D6). Auto Backup would
         upload the WebView's localStorage and the on-disk Firestore cache
         — every question seen and answered — to the user's Google Drive,
         in an app whose data inventory says local state stays on the
         device. The cost is real: this also disables device-to-device
         transfer, so an anonymous user who never links Google loses their
         history on a phone swap. The privacy panel says so. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links: https://prvfire33.web.app/join/CODE opens the
                 app (appUrlOpen → src/v2/data/links.ts). autoVerify only
                 succeeds once /.well-known/assetlinks.json carries the real
                 Play signing SHA-256 (it ships with a placeholder — see
                 SHIP-CHECKLIST); until then the link opens the hosted
                 fallback page, which still works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="prvfire33.web.app"
                      android:pathPrefix="/join/" />
            </intent-filter>

        </activity>

        <!-- Reveal notification presentation. Without the icon meta-data
             Android falls back to the launcher icon, which it renders as a
             silhouette — a solid white square. Without a default channel
             id, a data-only message on Android 8+ has no channel to post
             to and the notification is dropped entirely while the app is
             BACKGROUNDED, which is exactly when a reveal arrives.
             The channel itself is created in src/v2/data/push.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_reveal" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/reveal_notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reveals" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (targetSdk 33+) requires this runtime permission
         before any notification — including the reveal push — can be
         shown. push.ts requests it via PushNotifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- COARSE only, and never FINE (D9). The single question this answers
         is "which of 10,929 cities is nearest?", which coarse location
         settles comfortably — the catalogue's own coordinates are stored to
         2dp (~1.1 km), so a finer fix could not change the answer.
         Requesting FINE would ask for street-level precision the app has no
         use for, and Android would rightly show the user the stronger
         prompt.

         The fix is resolved to a city name ON THE DEVICE and then
         discarded: no coordinate is transmitted or stored, and what leaves
         the phone is "Oslo, NO" — the same string the manual picker
         produces. See src/v2/data/places.ts (nearestPlace).

         Optional in the product sense too: declining leaves the city picker
         working exactly as before. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- FINE, capped at API 30, and this needs its reason on the record
         because it looks like exactly the over-ask the block above refuses.

         @capacitor/geolocation picks its permission alias by OS version
         (GeolocationPlugin.kt, getAlias): on API 31+ with
         enableHighAccuracy:false it requests COARSE alone, but below 31 it
         requests the alias [COARSE, FINE] — and Capacitor's Bridge resolves
         a multi-string alias as "all granted, or none"
         (Bridge.getPermissionStates). With COARSE alone declared, that alias
         can NEVER reach GRANTED on API 24-30: the prompt appears, the user
         accepts, and the call still fails. Permanently. The WebView's own
         navigator.geolocation path has the identical check
         (BridgeWebChromeClient.onGeolocationPermissionsShowPrompt), so
         there is no way around it from JS either.

         maxSdkVersion="30" confines that to the versions that structurally
         need it. On API 31+ — where Android added the user-facing
         Approximate/Precise choice this app actually cares about — FINE is
         not declared at all, so precise location is unobtainable by
         construction rather than by policy. On API 24-30 there is no such
         choice in the OS prompt regardless of what is requested.

         Delete this the day minSdkVersion reaches 31. -->
    <!-- UNCAPPED SINCE D174. The maxSdkVersion="30" above used to make
         precise location unobtainable by construction on API 31+; the
         venue-scale Near the owner asked for cannot be measured by a
         coarse fix, and a finer grid over a coarse measurement would be
         invented precision. The coordinate is still folded to a 0.002°
         cell on the device and discarded, so the fix being precise
         changes what is MEASURED, not what is sent. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- That is the complete list. The app requests no camera and no photo
         library: the v1 surfaces that needed them were removed in D4. -->
</manifest>
