<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup is off deliberately (decision D6). Auto Backup would
         upload the WebView's localStorage and the on-disk Firestore cache
         — every question seen and answered — to the user's Google Drive,
         in an app whose data inventory says local state stays on the
         device. The cost is real: this also disables device-to-device
         transfer, so an anonymous user who never links Google loses their
         history on a phone swap. The privacy panel says so. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Reveal notification presentation. Without the icon meta-data
             Android falls back to the launcher icon, which it renders as a
             silhouette — a solid white square. Without a default channel
             id, a data-only message on Android 8+ has no channel to post
             to and the notification is dropped entirely while the app is
             BACKGROUNDED, which is exactly when a reveal arrives.
             The channel itself is created in src/v2/data/push.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_reveal" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/reveal_notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reveals" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (targetSdk 33+) requires this runtime permission
         before any notification — including the reveal push — can be
         shown. push.ts requests it via PushNotifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- That is the complete list. The app requests no camera, no photo
         library and no location: the v1 surfaces that needed them were
         removed in D4. (Three comment blocks describing those permissions
         outlived the permissions themselves and are gone — a manifest that
         appears to discuss camera and location is the wrong thing to hand
         a privacy reviewer for an app that collects neither.) -->
</manifest>
