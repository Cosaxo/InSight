<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>InSight</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Google sign-in callback (D3: the only way an anonymous account can
	     be upgraded without losing its uid and history). The plugin's
	     GoogleAuthProviderHandler calls GIDSignIn.signIn(withPresenting:),
	     and GoogleSignIn-iOS hands the OAuth result back through a custom
	     URL scheme — the REVERSED_CLIENT_ID from GoogleService-Info.plist.
	     Without this block registered there is no scheme to return to.

	     The value cannot be committed: GoogleService-Info.plist is
	     untracked (it is account-gated, see docs/SHIP-CHECKLIST.md §4), so
	     this ships as a placeholder in the same REPLACE_WITH_* form as the
	     two files under web/.well-known/. `npm run check:store-copy`
	     fails while it is unreplaced — the failure is otherwise silent and
	     device-only: everything compiles, the account sheet opens, and the
	     flow simply never returns. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cosaxo.insight.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.437999864865-vqpbjkbk34fsqms3st4pt09f72rc2dan</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Location, when-in-use only (D9). Shown verbatim in the system
	     prompt, so it says what actually happens rather than what the
	     feature is called. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used once, on this device, to work out which city you are nearest so the daily can show how your city answered. Your coordinates are never sent anywhere and never stored — only the city name. You can skip this and pick your city from a list instead.</string>
	<!-- The same string again, for an authorisation this app never asks for.
	     Apple's upload analysis reads the linked binary, not the call
	     sites: @capacitor/geolocation depends on ion-ios-geolocation, whose
	     IONGLOCAuthorisationRequestType has an `always` branch naming
	     CLLocationManager.requestAlwaysAuthorization, so that symbol ships
	     in every archive and the key becomes mandatory even though nothing
	     in this app can reach it. Without it, App Store Connect accepts the
	     build and then emails ITMS-90683 — which is how this was found, on
	     2.0.0 build 10.

	     Both halves verified in source rather than inferred from the
	     warning: the `always` branch is in the upstream enum, and the
	     plugin's only call site is
	     `requestLocationAuthorisation(type: .whenInUse)`
	     (GeolocationPlugin.swift). The plugin's own README says to add this
	     key with the same text as the when-in-use one, because the prompt
	     cannot appear.

	     Identical by rule: `npm run check:ios-location` fails if the two
	     strings drift. A string nobody can see is one nobody would notice
	     growing a claim the app does not honour — and this one sits beside
	     web/privacy.html's "no location history, no background location".
	     The key grants nothing on its own: an Always prompt needs an Always
	     request, and UIBackgroundModes above carries remote-notification
	     only. The same check holds that pair too. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Used once, on this device, to work out which city you are nearest so the daily can show how your city answered. Your coordinates are never sent anywhere and never stored — only the city name. You can skip this and pick your city from a list instead.</string>
	<!-- Ask for REDUCED accuracy by default (iOS 14+). The system then hands
	     back a coarse fix — roughly neighbourhood-level — and the permission
	     sheet shows "Precise: Off" with the user free to turn it on rather
	     than the app asking for precision it has no use for.
	     The catalogue's own coordinates are 2dp (~1.1 km), so a precise fix
	     could not change which city is nearest. There is no
	     requestTemporaryFullAccuracy call anywhere in this app: reduced is
	     not a default we quietly escalate from. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
</dict>
</plist>
