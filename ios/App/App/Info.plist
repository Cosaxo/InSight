<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>InSight</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Google sign-in callback (D3: the only way an anonymous account can
	     be upgraded without losing its uid and history). The plugin's
	     GoogleAuthProviderHandler calls GIDSignIn.signIn(withPresenting:),
	     and GoogleSignIn-iOS hands the OAuth result back through a custom
	     URL scheme — the REVERSED_CLIENT_ID from GoogleService-Info.plist.
	     Without this block registered there is no scheme to return to.

	     The value cannot be committed: GoogleService-Info.plist is
	     untracked (it is account-gated, see docs/SHIP-CHECKLIST.md §4), so
	     this ships as a placeholder in the same REPLACE_WITH_* form as the
	     two files under web/.well-known/. `npm run check:store-copy`
	     fails while it is unreplaced — the failure is otherwise silent and
	     device-only: everything compiles, the account sheet opens, and the
	     flow simply never returns. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cosaxo.insight.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REPLACE_WITH_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Location, when-in-use only (D9). Shown verbatim in the system
	     prompt, so it says what actually happens rather than what the
	     feature is called. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used once, on this device, to work out which city you are nearest so the daily can show how your city answered. Your coordinates are never sent anywhere and never stored — only the city name. You can skip this and pick your city from a list instead.</string>
	<!-- Ask for REDUCED accuracy by default (iOS 14+). The system then hands
	     back a coarse fix — roughly neighbourhood-level — and the permission
	     sheet shows "Precise: Off" with the user free to turn it on rather
	     than the app asking for precision it has no use for.
	     The catalogue's own coordinates are 2dp (~1.1 km), so a precise fix
	     could not change which city is nearest. There is no
	     requestTemporaryFullAccuracy call anywhere in this app: reduced is
	     not a default we quietly escalate from. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
</dict>
</plist>
