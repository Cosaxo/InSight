# Copy to `.env` to point the app at a Firebase project. Leave the
# required four blank to run in mock mode (demo data, no backend).
# For the local emulators, use `cp .env.emulator .env` instead.
#
# Firebase *web* keys identify a project; they are not secrets — access
# control lives in firestore.rules.

# Required for Firebase to activate
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000

# Optional
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# v2: wire the daily/feed/duels to live Firestore (vs. demo data)
VITE_V2_LIVE=true

# Optional — crash reporting (off without a DSN; on by default with one,
# honouring the in-app opt-out — D76). Set for TestFlight/production builds.
VITE_SENTRY_DSN=
VITE_RELEASE_TAG=

# Optional — the first-launch account wall (D134). Off unless exactly
# "true"; the public build ships without it.
VITE_REQUIRE_SIGNIN=

# Optional — the named Firestore database (D165). Defaults to `insight`,
# which is what firebase.json deploys and what check:fn-runtime pins every
# trigger to; overriding it points the client at a database the triggers do
# not watch, so the app writes and nothing ever folds.
VITE_FIRESTORE_DB_ID=

# Optional — App Check. Native attests through DeviceCheck / Play Integrity
# and consults neither of these; both are the WEB path, which is developers
# and CI rather than users (there is no public web build — web/home.html:
# "Deliberately NOT the app").
#
# Leave both empty and App Check is simply skipped on web, which is fine
# until Firestore enforcement is flipped on in the console
# (LAUNCH-RUNBOOK 3.4) — after that an unattested browser is refused, and
# that includes yours. Set ONE of:
#
#   VITE_APPCHECK_DEBUG=true    mint a token, printed to the browser console;
#                               register it once under App Check › Apps ›
#                               Manage debug tokens. For a person's browser.
#   VITE_APPCHECK_DEBUG=<token> use an already-registered token. The only
#                               form CI can use — a freshly minted one would
#                               need registering every run.
#   VITE_APPCHECK_RECAPTCHA_SITE_KEY=…   a real reCAPTCHA v3 registration.
#                               Only worth provisioning if a public web
#                               build ever ships; a headless browser tends to
#                               score badly on v3 anyway, which is why CI
#                               uses a token.
#
# A debug token is a BYPASS: whoever holds it gets past App Check. Keep it in
# secrets, one per environment, and never in a build that reaches users —
# vite.config.ts refuses a production build carrying one.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG=
