rules_version = '2';

// Firebase Storage rules — owner-only access to a user's uploads. The
// only path named is users/{uid}/dailyPhotos/, a RETIRED v1 surface
// (daily-report photo backup, removed in D4) kept until the bucket is
// confirmed empty. We deny everything else by default.
//
// Deliberately untouched by D94, and recorded here so it does not read
// as an oversight: D94 publishes ANSWERS. A photo is not an answer, the
// path is dead, and nothing on the Mirror reads it.
//
// Deploy with: firebase deploy --only storage
// (NOT `--only storage:rules` — the colon form names a multi-bucket
// deploy target, which this project doesn't configure, and it errors.)
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/dailyPhotos/{filename} {
      // Owner-only read + write. App Check (when enabled at the
      // bucket level via the Firebase console) further restricts
      // requests to attested clients.
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        // Cap upload size at 8 MB — generous for a JPEG, prevents
        // a runaway client from filling the bucket.
        && (request.resource == null || request.resource.size < 8 * 1024 * 1024)
        // Only image content types. The filename has a .jpg
        // extension by convention; this is the actual gate.
        && (request.resource == null || request.resource.contentType.matches('image/.*'));
    }

    // Everything else: explicitly denied. Adds an extra line of
    // defence beyond Storage's default-deny in case a future
    // rules edit accidentally widens reach.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
