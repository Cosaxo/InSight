rules_version = '2';

// Firebase Storage rules — owner-only writes, and since D178 one path a
// signed-in user may READ: avatars/{uid}, the profile photo.
//
// Two paths are named. `avatars/{uid}` is live (D178). The other,
// users/{uid}/dailyPhotos/, is a RETIRED v1 surface (daily-report photo
// backup, removed in D4) kept read/delete-only until the bucket is
// confirmed empty. Everything else is denied by default.
//
// D98's note on this file used to say "a photo is not an answer, the path
// is dead, and nothing on the Mirror reads it." Two thirds of that stopped
// being true at D178 and the sentence is kept here as the record: a photo
// is still not an answer, and the reason avatars are world-readable is not
// D98 but the same argument D177 made for the room — the surfaces that
// show a face already show the name beside it.
//
// Deploy with: firebase deploy --only storage
// (NOT `--only storage:rules` — the colon form names a multi-bucket
// deploy target, which this project doesn't configure, and it errors.)
service firebase.storage {
  match /b/{bucket}/o {
    // ── The profile photo (D178) ───────────────────────────────────
    //
    // ONE OBJECT PER ACCOUNT, AT A FIXED ID, and that is the whole reason
    // this path has no {filename}. The retired path below records what a
    // free filename cost: unbounded object count, unbounded stored bytes
    // and unbounded egress, from an anonymous-first app where an account
    // is free. A fixed id makes a second upload an OVERWRITE, so the
    // object count is bounded by the account count by construction rather
    // than by a rule someone has to remember to write.
    //
    // Readable by any signed-in user, which is the grant that did not
    // exist here before. It is not D98's doing — D98 published answers —
    // it is D177's argument: every surface that will draw this face
    // already draws the name beside it, so the photo adds a likeness to a
    // person who was already identified, on screens whose whole subject
    // is who people are.
    //
    // 256 KB is roughly ten times what the uploader produces: it
    // downscales to AVATAR_PX and re-encodes before it ever reaches here
    // (src/v2/data/avatar.ts), so this cap is the backstop for a modified
    // client rather than the thing a real upload has to fit. Keeping it
    // small matters more than it looks — this is the app's only egress
    // path, and a room of two dozen faces reads two dozen objects.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          // A delete presents no resource; only an upload has bytes to
          // check. Written as one rule because Storage's `write` covers
          // both and splitting it would leave `delete` needing its own
          // copy of the ownership test.
          request.resource == null
          || (request.resource.size < 256 * 1024
              && request.resource.contentType.matches('image/(jpeg|png|webp)'))
        );
    }

    match /users/{uid}/dailyPhotos/{filename} {
      // Owner-only READ and DELETE. Uploads are closed — see below.
      //
      // App Check (when enabled at the bucket level via the Firebase
      // console) further restricts requests to attested clients.
      allow read, delete: if request.auth != null
        && request.auth.uid == uid;

      // NO create/update, and the asymmetry is the point.
      //
      // The grant on this path is a legacy one: D4 removed the daily-report
      // photo backup and nothing in the app has touched Storage since —
      // `getStorage` and `firebase/storage` appear nowhere in src/ or
      // functions/src, only a `storageBucket` config field. So every byte
      // this path could accept is a byte no feature asked for.
      //
      // What it WAS accepting: any signed-in account, and the app is
      // anonymous-first (D3), so that is any account at all — 8 MB per
      // object with `{filename}` unbounded, meaning unbounded object count,
      // unbounded stored bytes and unbounded egress reading them back.
      // docs/COSTS.md bills Storage at "$0 (bucket unused)", which was true
      // of the app's behaviour and not of the rule's.
      //
      // WHY NOT A FLAT DENY, which is the obvious version of this fix.
      // Because the grant is deliberate and the reason is recorded in
      // firestore-tests/storage.rules.test.ts: deleteAccount does not touch
      // Storage, so revoking access to objects that still exist would open
      // an erasure gap rather than close a hole. That argument is about
      // READ and DELETE — a v1 user reaching their own leftover photo to
      // remove it — and it says nothing about accepting new bytes. Splitting
      // the verb keeps the erasure property exactly as it was and closes the
      // only unbounded-egress surface in the project.
      //
      // The 8 MB and image/* checks are gone with the write grant they
      // guarded. They were a bound on a runaway client, not a bound on the
      // number of objects, which is the term that actually had no ceiling.
    }

    // Everything else: explicitly denied. Adds an extra line of
    // defence beyond Storage's default-deny in case a future
    // rules edit accidentally widens reach.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
